# Base URL for Khronos glTF sample models, fetched at runtime by stages/gltf.ts.
# Pinned to the same commit as the packages/gltf-samples submodule — keep in sync when bumping.
# To serve a local submodule checkout in dev instead, override in .env.development.local:
#   VITE_GLTF_SAMPLES_BASE=/@fs/<absolute-repo-path>/packages/gltf-samples/Models
VITE_GLTF_SAMPLES_BASE=https://cdn.jsdelivr.net/gh/KhronosGroup/glTF-Sample-Assets@2bac6f8c57bf471df0d2a1e8a8ec023c7801dddf/Models
