{
  "name": "web-3d-phys-engine",
  "version": "1.0.0",
  "description": "WebGPU-based 3D physics engine with GPU-accelerated computation",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @web-3d-phys-engine/web-client dev",
    "build": "tsc && pnpm --filter @web-3d-phys-engine/web-client build",
    "preview": "pnpm --filter @web-3d-phys-engine/web-client preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt packages/ecs/src packages/renderer/src packages/web-client/src scripts",
    "format:check": "oxfmt --check packages/ecs/src packages/renderer/src packages/web-client/src scripts"
  },
  "keywords": [
    "webgpu",
    "physics",
    "3d",
    "game-engine",
    "typescript",
    "wgsl"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@gltf-transform/core": "4.2.1",
    "@types/chroma-js": "3.1.1",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.8",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "3.2.4",
    "@webgpu/types": "^0.1.64",
    "fs-extra": "^11.3.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^25.0.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=21.0.0"
  }
}
